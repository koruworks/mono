#!/usr/bin/env python3
import json
import sys

trace_path = __import__("os").environ.get("CODEX_FIXTURE_TRACE")


def trace(value):
    if trace_path:
        with open(trace_path, "a", encoding="utf-8") as output:
            output.write(value + "\n")


trace("args:" + ",".join(sys.argv[1:]))
trace("pid:" + str(__import__("os").getpid()))
# The bearer never rides argv (ADR-341): the launch names the variable and
# sets it on this process. The trace says only whether it arrived.
trace("bearer_env:" + ("set" if __import__("os").environ.get("KORU_RUN_MCP_TOKEN") else "unset"))


def register_result():
    """What a real delegated agent does: write a file under the run's own
    .artifacts/<RunId>/ folder, then register it through the run's MCP
    endpoint with the bearer it was handed. The URL is an override on argv,
    the run id is inside it, and the folder is under the working directory
    this process was started in."""
    import os
    import re
    import urllib.error
    import urllib.request

    override = next(
        (arg for arg in sys.argv[1:] if arg.startswith("mcp_servers.koru_run.url=")), None
    )
    if override is None:
        trace("register:no_endpoint")
        return
    url = override[len("mcp_servers.koru_run.url=") :].strip("'")
    matched = re.search(r"/v1/runs/([^/]+)/mcp$", url)
    if matched is None:
        trace("register:unparsable_endpoint")
        return
    token = os.environ.get("KORU_RUN_MCP_TOKEN")
    if not token:
        trace("register:no_bearer")
        return
    folder = os.path.join(os.getcwd(), ".artifacts", matched.group(1))
    os.makedirs(folder, exist_ok=True)
    with open(os.path.join(folder, "result.md"), "w", encoding="utf-8") as handle:
        handle.write("FIXTURE_RESULT")
    body = json.dumps(
        {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {
                "name": "create",
                "arguments": {
                    "path": "result.md",
                    "title": "Fixture result",
                    "mime": "text/markdown",
                },
            },
        }
    ).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=body,
        headers={"content-type": "application/json", "authorization": "Bearer " + token},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as answer:
            payload = json.loads(answer.read().decode("utf-8"))
        if payload.get("result", {}).get("isError"):
            trace("register:refused:" + str(payload["result"].get("structuredContent", {}).get("code")))
        else:
            trace("register:ok")
    except (urllib.error.URLError, OSError, ValueError) as error:
        trace("register:failed:" + type(error).__name__)

if sys.argv[1:] == ["--version"]:
    print("codex-cli 0.150.1", flush=True)
    raise SystemExit(0)
if not sys.argv[1:] or sys.argv[1] != "app-server":
    raise SystemExit(2)


def send(value):
    print(json.dumps(value, separators=(",", ":")), flush=True)


def native_rpc(method, params):
    import os
    import urllib.request
    override = next(arg for arg in sys.argv[1:] if arg.startswith("mcp_servers.koru_run.url="))
    endpoint = override.split("=", 1)[1].strip("'")
    request = urllib.request.Request(endpoint, data=json.dumps({
        "jsonrpc": "2.0", "id": 1, "method": method, "params": params
    }).encode(), headers={"content-type": "application/json", "authorization": "Bearer " + os.environ["KORU_RUN_MCP_TOKEN"]})
    with urllib.request.urlopen(request, timeout=30) as response:
        answer = json.load(response)
    assert "error" not in answer, "native RPC refused"
    return answer["result"]


def native_call(identity, name, arguments, refused=False):
    trace("native:call:" + identity)
    item = {"type": "mcpToolCall", "id": identity, "server": "koru_run", "tool": name, "arguments": arguments, "status": "inProgress"}
    send({"method": "item/started", "params": {"threadId": "fixture-thread", "turnId": "fixture-turn", "item": item}})
    result = native_rpc("tools/call", {"name": name, "arguments": arguments})
    assert bool(result.get("isError")) == refused, "native tool outcome mismatch"
    item.update(status="failed" if refused else "completed", result=result)
    send({"method": "item/completed", "params": {"threadId": "fixture-thread", "turnId": "fixture-turn", "item": item}})
    return result.get("structuredContent")


def native_discover():
    names = sorted(tool["name"] for tool in native_rpc("tools/list", {})["tools"])
    if names != ["correct_memory", "create_document", "create_routine", "edit_document", "forget_memory", "list_memory", "list_routines", "read_document", "read_memory", "read_routine_creation", "remember_memory", "retry_routine_creation", "search_documents"]:
        trace("native:catalog-mismatch:" + str(len(names)))
        raise AssertionError("native catalog mismatch")
    trace("native:catalog:13")


def native_pages():
    import os
    import time
    import copy
    trace("native:turn")
    with open(os.environ["CODEX_FIXTURE_NATIVE_CONFIG"], encoding="utf-8") as handle:
        config = json.load(handle)
    try:
        create = {"operation_id": "11111111-1111-4111-8111-111111111111", "workspace_id": config["workspace"], "title": "Native fixture result",
                  "initial_operations": [{"op": "insert", "node_id": "body", "parent_id": "root", "after_node_id": None, "kind": "paragraph", "text": "NATIVE ORIGINAL"}]}
        created = native_call("native-create", "create_document", create)
        assert created["status"] == "saved"
        repeated = native_call("native-create-replay", "create_document", create)
        assert (repeated["document_id"], repeated["base_revision"]) == (created["document_id"], created["base_revision"])
        read = {"workspace_id": config["workspace"], "document_id": created["document_id"]}
        before = native_call("native-read-before", "read_document", read)
        nodes = [node for node in before["nodes"] if node.get("content", {}).get("text") == "NATIVE ORIGINAL"]
        assert len(nodes) == 1
        edit = {"operation_id": "22222222-2222-4222-8222-222222222222", "workspace_id": config["workspace"], "document_id": created["document_id"], "base_revision": before["revision"],
                "operations": [{"op": "replace_text", "node_id": nodes[0]["node_id"], "expected": "NATIVE ORIGINAL", "text": "NATIVE EDITED"}]}
        edited = native_call("native-edit", "edit_document", edit)
        assert edited["status"] == "saved"
        repeated = native_call("native-edit-replay", "edit_document", edit)
        assert (repeated["document_id"], repeated["base_revision"]) == (created["document_id"], edited["base_revision"])
        changed = copy.deepcopy(create)
        changed["title"] = "Changed payload"
        native_call("native-create-conflict", "create_document", changed, True)
        stale = copy.deepcopy(edit)
        stale["operation_id"] = "33333333-3333-4333-8333-333333333333"
        native_call("native-stale-edit", "edit_document", stale, True)
        after = native_call("native-read-after", "read_document", read)
        assert len([node for node in after["nodes"] if node.get("content", {}).get("text") == "NATIVE EDITED"]) == 1
        with open(config["report"], "w", encoding="utf-8") as handle:
            json.dump({"status": "ready", "document": created["document_id"]}, handle)
        deadline = time.monotonic() + 30
        while not os.path.exists(config["finish"]):
            assert time.monotonic() < deadline, "native inspection timeout"
            time.sleep(0.025)
    except Exception:
        trace("native:failed")
        with open(config["report"], "w", encoding="utf-8") as handle:
            json.dump({"status": "failed"}, handle)
        raise RuntimeError("native scripted sequence failed") from None


for line in sys.stdin:
    message = json.loads(line)
    method = message.get("method")
    trace("method:" + str(method))
    if method == "initialize":
        send({"id": message["id"], "result": {"userAgent": "koru_terminal/0.150.1 (fixture)", "codexHome": "fixture", "platformFamily": "unix", "platformOs": "unix"}})
    elif method == "model/list":
        send({"id": message["id"], "result": {"data": [{"id": "fixture-model", "model": "fixture-model", "displayName": "Fixture", "description": "fixture", "isDefault": True, "hidden": False, "defaultReasoningEffort": "medium", "supportedReasoningEfforts": [], "inputModalities": ["text", "image"]}], "nextCursor": None}})
    elif method == "thread/start":
        if __import__("os").environ.get("CODEX_FIXTURE_TURN") == "native":
            assert message["params"]["model"] == "fixture-model", "native requested model mismatch"
            trace("native:model:fixture-model")
            native_discover()
        send({"id": message["id"], "result": {"thread": {"id": "fixture-thread"}}})
    elif method == "turn/start":
        images = [part for part in message["params"]["input"] if part.get("type") == "localImage"]
        image = images[0] if images else None
        if __import__("os").environ.get("CODEX_FIXTURE_TURN") == "native":
            # Counts only: a picture's path names the disposable root.
            trace("native:images:" + str(len(images)))
            trace("native:images-on-disk:" + str(sum(1 for part in images if __import__("os").path.isfile(part["path"]))))
        send({"id": message["id"], "result": {"turn": {"id": "fixture-turn", "status": "inProgress", "items": []}}})
        text = "FIXTURE_NATIVE_TEXT" if __import__("os").environ.get("CODEX_FIXTURE_TURN") == "native" else "FIXTURE_TEXT"
        send({"method": "item/agentMessage/delta", "params": {"threadId": "fixture-thread", "turnId": "fixture-turn", "itemId": "message-1", "delta": text}})
        if image is not None:
            send({"method": "item/completed", "params": {"threadId": "fixture-thread", "turnId": "fixture-turn", "item": {"type": "imageView", "id": "image-1", "path": image["path"]}}})
        # CODEX_FIXTURE_TURN=complete: the turn reports its usage and ends
        # cleanly with no approval (P1.6's process test drives a run to its end).
        if __import__("os").environ.get("CODEX_FIXTURE_TURN") == "register":
            register_result()
        if __import__("os").environ.get("CODEX_FIXTURE_TURN") == "native":
            native_pages()
        if __import__("os").environ.get("CODEX_FIXTURE_TURN") in ("complete", "register", "native"):
            usage = {"inputTokens": 120, "outputTokens": 40, "cachedInputTokens": 20}
            send({"method": "thread/tokenUsage/updated", "params": {"threadId": "fixture-thread", "turnId": "fixture-turn", "tokenUsage": {"last": usage, "total": usage, "modelContextWindow": 1000}}})
            send({"method": "turn/completed", "params": {"threadId": "fixture-thread", "turn": {"id": "fixture-turn", "items": [], "status": "completed", "error": None}}})
            continue
        send({"method": "item/commandExecution/requestApproval", "id": "fixture-approval", "params": {"threadId": "fixture-thread", "turnId": "fixture-turn", "itemId": "tool-1", "command": "redacted"}})
    elif method == "turn/interrupt":
        send({"id": message["id"], "result": {}})
        send({"method": "turn/completed", "params": {"threadId": "fixture-thread", "turn": {"id": "fixture-turn", "items": [], "status": "interrupted", "error": None}}})
