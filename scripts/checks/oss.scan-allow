# oss.scan-allow: reviewed exceptions to scripts/checks/oss-scan.py.
#
# Each line is `<path glob> <category> <match> # why`. The glob is relative to
# the scanned directory, normally the repository root (`*` within a segment,
# `**` across segments); the category is ipv4, home-path, email, secret or
# cto; <match> is the matched text exactly, or `*` for any match of that
# category in those paths. A reason is required, and an entry that stops
# matching fails the scan, so the list cannot rot.
#
# Prefer fixing the content. An exception is for text that must stay: a test
# sample, a third party's notice, an approved public address.

guide/user/USERGUIDE.md email support@koru.do # public support mailbox shown by the app

# The scanner's own tests feed it one sample of everything it must catch.
scripts/checks/test_oss_checks.py ipv4 * # scanner test samples
scripts/checks/test_oss_checks.py home-path * # scanner test samples
scripts/checks/test_oss_checks.py email * # scanner test samples
scripts/checks/test_oss_checks.py cto * # scanner test samples

# Third parties' own notices and manifests: their authors' addresses are part
# of the license text we must reproduce unchanged.
crates/koru-release/licences/bundled/onnxruntime.txt email * # upstream notice, reproduced verbatim
crates/koru-release/licences/crates/dlopen2.txt email * # upstream license record, reproduced verbatim

# Frozen bytes, deliberately left: contract vectors are hashed, so they are
# not edited.
contracts/vectors/logical-usage-v1/*.json cto * # frozen contract vector text
contracts/vectors/regional-bootstrap-resolver-v1/cases.json email user@api.koru.do # frozen vector; an account identifier shape, not a mailbox

# Public product mailboxes on koru.do. The app, its docs and TRADEMARKS.md
# show them.
TRADEMARKS.md email hello@koru.do # public contact address
apps/koru/src/mainview/update_ui.rs email hello@koru.do # public contact address shown in the app
crates/koru-window/src/open_uri.rs email hello@koru.do # public contact address, mailto test
crates/koru-ui/src/welcome.rs email support@koru.do # public support address shown in the app

# Synthetic addresses in tests: made-up people and domains (acme.com,
# personal.co, b.co) or provider identifier shapes, never real mailboxes.
apps/koru/src/feedback/*.rs email person@koru.do # synthetic test address
apps/koru/src/panes/explore/tests.rs email * # synthetic test addresses
apps/android/app/src/test/**/BrowserSignInTest.kt email user@appleid.apple.com # provider identifier shape in a test
crates/koru-account-client/src/tests.rs email user@api.koru.do # account identifier shape in a test
crates/koru-account-core/src/email/tests.rs email * # address-validation test samples
crates/koru-account-runtime/src/account/tests.rs email user@accounts.google.com # provider identifier shape in a test
crates/koru-core/src/profile/tests.rs email sam@acme.com # synthetic test address
crates/koru-docstore/src/**.rs email sam@acme.com # synthetic profile address in docs and tests
crates/koru-draw/src/**.rs email a@b.com # link-detection test sample
crates/koru-editor/src/trigger.rs email b@c.com # trigger test sample
apps/koru/src/panes/explore/popover_baseline.rs email * # synthetic over-long address, for truncation

# A non-Latin user name, testing that paths survive Unicode.
apps/koru-relay/src/cli/tests.rs home-path * # Unicode user-name path sample
apps/koru-store-server/src/cli/tests.rs home-path * # Unicode user-name path sample

# Dotted numbers that are not addresses: vector path data and version samples.
crates/koru-draw/src/icon_pack_data.rs ipv4 * # SVG path numbers in the icon pack's data
crates/koru-release/src/mobile/tests.rs ipv4 0.1.5.1 # a malformed-version test sample

# Sample paths in a comment, not anybody's machine.
crates/koru-ai-ui/src/tool_output/picture.rs home-path /home/a.png # file-URL sample in a doc comment
