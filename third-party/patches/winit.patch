+
+/// Apply the current request behind a closed delivery gate. Every transition,
+/// including enable, resets the native context: an inline enable can overtake
+/// an external caller's posted disable. Obsolete posted work then does nothing.
+/// Native actions are separate so no WindowState lock survives a reentrant call.
+pub(super) fn apply_ime_request(
+    state: &Mutex<WindowState>,
+    stamp: &ImeStamp,
+    allowed: bool,
+    mut native: impl FnMut(ImeAction) -> bool,
+) {
+    let (retry_reset, active) = {
+        let mut state = state.lock().unwrap();
+        if !stamp.is_current() {
+            return;
+        }
+        let active = state.ime_state != ImeState::Disabled;
+        let retry = state.ime_reset_failed;
+        state.ime_allowed = false;
+        state.ime_state = ImeState::Disabled;
+        state.ime_applied = Some(stamp.clone());
+        // A nested request must cancel if this operation has not returned.
+        state.ime_reset_failed = true;
+        (retry, active)
