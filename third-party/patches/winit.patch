--- /dev/null
+++ b/src/platform_impl/linux/x11/ime/tests.rs
@@ -0,0 +1,51 @@
+use super::*;
+use crate::event::{Ime as PublicIme, WindowEvent};
+use crate::platform_impl::ime_lifetime::ImeLifetime;
+use std::collections::HashMap;
+use std::sync::mpsc::channel;
+
+#[test]
+fn direct_commit_follows_the_context_enabled_event() {
+    let (sender, receiver) = channel();
+    let life = ImeLifetime::default();
+    let guard = ImeGuard { context: life.request(true).unwrap(), window: None };
+    sender.send((1, guard.clone(), ImeEvent::Enabled)).unwrap();
+    sender.send((1, guard, ImeEvent::Commit("live".into()))).unwrap();
+    let mut events = Vec::new();
+    dispatch_events(&receiver, &mut HashMap::new(), |_, event| {
+        if let WindowEvent::Ime(event) = event {
+            events.push(event);
+        }
+    });
+    assert_eq!(
+        events,
+        [
+            PublicIme::Enabled,
+            PublicIme::Preedit(String::new(), None),
+            PublicIme::Commit("live".into())
+        ]
+    );
+}
+
+#[test]
+fn clear_preedit_reentry_retires_commit_without_stopping_another_window() {
+    let (sender, receiver) = channel();
+    let first = ImeLifetime::default();
+    let second = ImeLifetime::default();
+    let guard = ImeGuard { context: first.request(true).unwrap(), window: None };
+    let other = ImeGuard { context: second.request(true).unwrap(), window: None };
+    sender.send((1, guard.clone(), ImeEvent::Start)).unwrap();
+    sender.send((2, other, ImeEvent::Start)).unwrap();
+    let mut composing = HashMap::new();
+    dispatch_events(&receiver, &mut composing, |_, _| {});
+    sender.send((1, guard, ImeEvent::Commit("old".into()))).unwrap();
+    let mut events = Vec::new();
+    dispatch_events(&receiver, &mut composing, |_, event| {
+        events.push(event);
+        first.request(false);
+        first.request(true);
+    });
+    assert_eq!(events.len(), 1);
+    assert!(composing.get(&2).unwrap().is_current());
+    assert!(!composing.get(&1).unwrap().is_current());
+}
