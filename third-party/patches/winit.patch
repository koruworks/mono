diff --git b/src/platform_impl/windows/ime/tests.rs b/src/platform_impl/windows/ime/tests.rs
new file mode 100644
index 00000000..29a2e563
--- /dev/null
+++ b/src/platform_impl/windows/ime/tests.rs
@@ -0,0 +1,99 @@
+use super::*;
+use crate::window::{Theme, WindowAttributes};
+
+fn state() -> Mutex<WindowState> {
+    Mutex::new(WindowState::new(&WindowAttributes::default(), 1.0, Theme::Light, None))
+}
+
+fn request(state: &Mutex<WindowState>, allowed: bool) -> ImeStamp {
+    state.lock().unwrap().ime_lifetime.request(allowed).unwrap()
+}
+
+#[test]
+fn inline_enable_overtaking_posted_disable_resets_before_reuse() {
+    let state = state();
+    let first = request(&state, true);
+    apply_ime_request(&state, &first, true, |_| true);
+    state.lock().unwrap().ime_state = ImeState::Preedit;
+    let posted_disable = request(&state, false);
+    let inline_enable = request(&state, true);
+    let mut actions = Vec::new();
+    apply_ime_request(&state, &inline_enable, true, |action| {
+        actions.push(action);
+        true
+    });
+    assert_eq!(actions, [ImeAction::Cancel { active: true }, ImeAction::Associate(true)]);
+    apply_ime_request(&state, &posted_disable, false, |_| {
+        panic!("obsolete disable must not detach the new context")
+    });
+    assert!(state.lock().unwrap().ime_allowed);
+    assert!(inline_enable.is_current());
+    assert!(!first.is_current());
+}
+
+#[test]
+fn idle_reset_does_not_depend_on_a_disabled_callback() {
+    let state = state();
+    let enabled = request(&state, true);
+    let mut actions = Vec::new();
+    apply_ime_request(&state, &enabled, true, |action| {
+        actions.push(action);
+        true
+    });
+    assert_eq!(actions, [ImeAction::Cancel { active: false }, ImeAction::Associate(true)]);
+    let disabled = request(&state, false);
+    apply_ime_request(&state, &disabled, false, |_| true);
+    let enabled = request(&state, true);
+    apply_ime_request(&state, &enabled, true, |_| true);
+    assert!(state.lock().unwrap().ime_allowed);
+}
+
+#[test]
+fn reset_failure_detaches_and_retries_before_enabling() {
+    let state = state();
+    let enabled = request(&state, true);
+    let mut actions = Vec::new();
+    apply_ime_request(&state, &enabled, true, |action| {
+        actions.push(action);
+        !matches!(action, ImeAction::Cancel { .. })
+    });
+    assert_eq!(actions, [ImeAction::Cancel { active: false }, ImeAction::Associate(false)]);
+    assert!(!state.lock().unwrap().ime_allowed);
+    assert!(state.lock().unwrap().ime_reset_failed);
+    let _posted_disable = request(&state, false);
+    let enabled = request(&state, true);
+    actions.clear();
+    apply_ime_request(&state, &enabled, true, |action| {
+        actions.push(action);
+        true
+    });
+    assert_eq!(
+        actions,
+        [
+            ImeAction::Associate(true),
+            ImeAction::Cancel { active: true },
+            ImeAction::Associate(true)
+        ]
+    );
+    assert!(state.lock().unwrap().ime_allowed);
+    assert!(!state.lock().unwrap().ime_reset_failed);
+}
+
+#[test]
+fn native_reentry_cannot_apply_old_completion_to_a_new_epoch() {
+    let state = state();
+    let old = request(&state, true);
+    let mut old_actions = Vec::new();
+    apply_ime_request(&state, &old, true, |action| {
+        old_actions.push(action);
+        if matches!(action, ImeAction::Cancel { .. }) {
+            request(&state, false);
+            let new = request(&state, true);
+            apply_ime_request(&state, &new, true, |_| true);
+        }
+        false // Even failure of the retired action must not detach the new epoch.
+    });
+    assert_eq!(old_actions, [ImeAction::Cancel { active: false }]);
+    assert!(state.lock().unwrap().ime_allowed);
+    assert!(!state.lock().unwrap().ime_reset_failed);
+}
