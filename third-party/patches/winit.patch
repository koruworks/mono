@@ -0,0 +1,56 @@
+use super::*;
+use crate::event::Ime;
+use crate::platform_impl::ime_lifetime::ImeLifetime;
+
+fn ime(event: Ime) -> Event<()> {
+    Event::WindowEvent { window_id: WindowId::dummy(), event: WindowEvent::Ime(event) }
+}
+
+#[test]
+fn buffered_ime_cannot_claim_a_replacement_target() {
+    let life = ImeLifetime::default();
+    let old = life.request(true).unwrap();
+    let queue = [
+        BufferedEvent::Ime(ime(Ime::Enabled), old.clone()),
+        BufferedEvent::Ime(ime(Ime::Commit("old".into())), old),
+    ];
+    life.request(false);
+    let new = life.request(true).unwrap();
+    let mut delivered = Vec::new();
+    for event in queue {
+        event.dispatch_event(|event| delivered.push(event));
+    }
+    assert!(delivered.is_empty());
+    BufferedEvent::Ime(ime(Ime::Commit("live".into())), new)
+        .dispatch_event(|event| delivered.push(event));
+    assert_eq!(delivered.len(), 1);
+}
+
+#[test]
+fn reentrant_clear_preedit_reset_discards_buffered_commit() {
+    let runner = Rc::new(EventLoopRunner::<()>::new(0));
+    let weak = Rc::downgrade(&runner);
+    let life = ImeLifetime::default();
+    let stamp = life.request(true).unwrap();
+    let callback_life = life.clone();
+    let callback_stamp = stamp.clone();
+    let delivered = Rc::new(RefCell::new(Vec::new()));
+    let recorded = delivered.clone();
+    // This is the real runner's reentrant queue, with no window or native calls.
+    unsafe {
+        runner.set_event_handler(move |event| {
+        let is_clear = matches!(&event, Event::WindowEvent { event: WindowEvent::Ime(Ime::Preedit(text, _)), .. } if text.is_empty());
+        recorded.borrow_mut().push(event);
+        if is_clear {
+            weak.upgrade().unwrap().send_ime_event(ime(Ime::Commit("retired".into())), callback_stamp.clone());
+            callback_life.request(false);
+            callback_life.request(true);
+        }
+    });
+    }
+    runner.send_ime_event(ime(Ime::Preedit(String::new(), None)), stamp);
+    runner.clear_event_handler();
+    assert!(runner.panic_error.take().is_none());
+    assert_eq!(delivered.borrow().len(), 1);
+    assert!(runner.event_buffer.borrow().is_empty());
+}
