diff --git b/src/platform_impl/linux/wayland/event_loop/sink/tests.rs b/src/platform_impl/linux/wayland/event_loop/sink/tests.rs
new file mode 100644
index 00000000..91b33238
--- /dev/null
+++ b/src/platform_impl/linux/wayland/event_loop/sink/tests.rs
@@ -0,0 +1,39 @@
+use super::*;
+use crate::event::Ime;
+use crate::platform_impl::ime_lifetime::ImeLifetime;
+
+#[test]
+fn synthetic_enable_cannot_expose_a_retired_native_commit() {
+    let life = ImeLifetime::default();
+    let old = life.request(true).unwrap();
+    let guard = ImeGuard { context: old, window: None };
+    let mut native = EventSink::new();
+    native.push_ime(Ime::Enabled, WindowId(1), guard.clone());
+    native.push_ime(Ime::Commit("old".into()), WindowId(1), guard);
+    life.request(false);
+    let new = life.request(true).unwrap();
+    let mut synthetic = EventSink::new();
+    synthetic.push_ime(Ime::Enabled, WindowId(1), ImeGuard { context: new, window: None });
+    let mut buffer = EventSink::new();
+    buffer.append(&mut synthetic);
+    buffer.append(&mut native);
+    assert_eq!(buffer.drain().filter(QueuedEvent::is_current).count(), 1);
+}
+
+#[test]
+fn delivery_checks_each_event_after_the_previous_callback() {
+    let life = ImeLifetime::default();
+    let guard = ImeGuard { context: life.request(true).unwrap(), window: None };
+    let mut sink = EventSink::new();
+    sink.push_ime(Ime::Preedit(String::new(), None), WindowId(1), guard.clone());
+    sink.push_ime(Ime::Commit("old".into()), WindowId(1), guard);
+    let mut delivered = 0;
+    for event in sink.drain() {
+        if event.is_current() {
+            delivered += 1;
+            life.request(false);
+            life.request(true);
+        }
+    }
+    assert_eq!(delivered, 1);
+}
