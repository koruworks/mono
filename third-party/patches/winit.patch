diff --git b/src/platform_impl/linux/wayland/seat/text_input/tests.rs b/src/platform_impl/linux/wayland/seat/text_input/tests.rs
new file mode 100644
index 00000000..a18855f7
--- /dev/null
+++ b/src/platform_impl/linux/wayland/seat/text_input/tests.rs
@@ -0,0 +1,55 @@
+use super::*;
+
+#[test]
+fn rejected_done_consumes_its_batch_before_a_live_done() {
+    let window = ImeLifetime::default();
+    let mut data = TextInputDataInner::default();
+    data.reset(window.request(true).unwrap());
+    data.serial.commit(Some(true));
+    window.request(false);
+    data.reset(window.request(true).unwrap());
+    data.serial.commit(Some(true));
+    data.pending_commit = Some("old".into());
+    assert!(data.take_pending(1).is_none());
+    let (_, commit, preedit) = data.take_pending(2).unwrap();
+    assert!(commit.is_none());
+    assert!(preedit.is_none());
+}
+
+#[test]
+fn a_retired_window_drops_pending_text_and_other_seat_remains_live() {
+    let window = ImeLifetime::default();
+    let stamp = window.request(true).unwrap();
+    let mut first = TextInputDataInner::default();
+    let mut second = TextInputDataInner::default();
+    first.reset(stamp.clone());
+    second.reset(stamp);
+    first.serial.commit(Some(true));
+    second.serial.commit(Some(true));
+    first.lifetime.retire();
+    first.pending_commit = Some("retired seat".into());
+    assert!(first.take_pending(1).is_none());
+    second.pending_commit = Some("live seat".into());
+    assert_eq!(second.take_pending(1).unwrap().1.as_deref(), Some("live seat"));
+    second.pending_commit = Some("retired target".into());
+    window.request(false);
+    assert!(second.take_pending(1).is_none());
+    assert!(second.pending_commit.is_none());
+}
+
+#[test]
+fn reset_clears_pending_preedit_and_preserves_the_commit_counter() {
+    let window = ImeLifetime::default();
+    let mut data = TextInputDataInner::default();
+    data.reset(window.request(true).unwrap());
+    data.serial.commit(Some(true));
+    data.serial.commit(None);
+    data.pending_preedit =
+        Some(Preedit { text: "old".into(), cursor_begin: Some(0), cursor_end: Some(0) });
+    data.reset(window.request(false).unwrap());
+    data.serial.commit(Some(false));
+    data.reset(window.request(true).unwrap());
+    data.serial.commit(Some(true));
+    assert!(data.take_pending(2).is_none());
+    assert!(data.take_pending(4).unwrap().2.is_none());
+}
