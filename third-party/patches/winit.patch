+++ b/src/platform_impl/ime_lifetime/tests.rs
@@ -0,0 +1,69 @@
+use super::*;
+
+#[test]
+fn retiring_rejects_queued_enabled_and_commit_without_waiting_for_disabled() {
+    let life = ImeLifetime::default();
+    let old = life.request(true).unwrap();
+    let queued = [old.clone(), old];
+    life.request(false).unwrap();
+    let new = life.request(true).unwrap();
+    assert!(queued.iter().all(|event| !event.is_current()));
+    assert!(new.is_current());
+    assert!(life.request(true).is_none());
+}
+
+#[test]
+fn reset_from_clear_preedit_callback_retires_the_rest_of_that_batch() {
+    let life = ImeLifetime::default();
+    let batch = life.request(true).unwrap();
+    assert!(batch.is_current()); // Preedit("", None) delivered.
+    life.request(false);
+    life.request(true); // The callback moved the caret in the same control.
+    assert!(!batch.is_current()); // Its Commit must not be retagged on dispatch.
+}
+
+#[test]
+fn windows_and_seats_have_independent_lifetimes() {
+    let window = ImeLifetime::default();
+    let other = ImeLifetime::default();
+    let seat = ImeLifetime::default();
+    let window_stamp = window.request(true).unwrap();
+    let other_stamp = other.request(true).unwrap();
+    let guard = ImeGuard { context: seat.snapshot(), window: Some(window_stamp.clone()) };
+    seat.retire();
+    assert!(!guard.is_current());
+    assert!(window_stamp.is_current());
+    window.request(false);
+    assert!(other_stamp.is_current());
+}
+
+#[test]
+fn wayland_accepts_old_but_current_serial_and_rejects_previous_enable() {
+    let mut serial = ImeSerial::default();
+    serial.commit(Some(true)); // 1
+    serial.commit(None); // Cursor rectangle, 2.
+    assert!(serial.accepts(1));
+    assert!(serial.accepts(1)); // Repeated serial is not a duplicate batch.
+    serial.commit(Some(false)); // 3
+    assert!(!serial.accepts(2));
+    serial.commit(Some(true)); // 4
+    assert!(!serial.accepts(2));
+    assert!(serial.accepts(4));
+    assert!(!serial.accepts(5));
+}
+
+#[test]
+fn wayland_serial_wrap_keeps_context_boundaries() {
+    let mut serial = ImeSerial { sent: u32::MAX - 1, enabled_at: None };
+    serial.commit(Some(true));
+    serial.commit(None);
+    assert!(serial.accepts(u32::MAX));
+    assert!(serial.accepts(0));
+    assert!(!serial.accepts(u32::MAX - 1));
+    serial.commit(Some(false));
+    serial.commit(Some(true));
+    assert!(!serial.accepts(0));
+    assert!(serial.accepts(2));
+    serial.retire();
+    assert!(!serial.accepts(2));
+}
diff --git b/src/platform_impl/ime_lifetime.rs b/src/platform_impl/ime_lifetime.rs
new file mode 100644
index 00000000..8bf7d1e2
--- /dev/null
+++ b/src/platform_impl/ime_lifetime.rs
@@ -0,0 +1,118 @@
+//! Private native-input lifetimes. Public IME events deliberately stay unchanged.
+//!
+//! Capture at the native callback/batch boundary, check again at application
+//! dispatch: delivering one event may synchronously retire the rest of its batch.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Arc;
+
+#[derive(Clone, Debug, Default)]
+pub(crate) struct ImeLifetime(Arc<AtomicU64>);
+
+#[derive(Clone, Debug)]
+pub(crate) struct ImeStamp {
+    lifetime: ImeLifetime,
+    value: u64,
+}
+
+impl ImeLifetime {
+    #[cfg(any(macos_platform, x11_platform, wayland_platform, test))]
+    pub(crate) fn snapshot(&self) -> ImeStamp {
+        ImeStamp { lifetime: self.clone(), value: self.0.load(Ordering::Acquire) }
+    }
+
+    /// Invalidate synchronously, before a queued platform request or cancellation.
+    pub(crate) fn request(&self, allowed: bool) -> Option<ImeStamp> {
+        let mut old = self.0.load(Ordering::Acquire);
+        loop {
+            if (old & 1 != 0) == allowed {
+                return None;
+            }
+            let next =
+                (old & !1).checked_add(2).expect("IME lifetime exhausted") | u64::from(allowed);
+            match self.0.compare_exchange_weak(old, next, Ordering::AcqRel, Ordering::Acquire) {
+                Ok(_) => return Some(ImeStamp { lifetime: self.clone(), value: next }),
+                Err(value) => old = value,
+            }
+        }
+    }
+
+    /// Retire an input context independently of its window's requested permission.
+    #[cfg(any(macos_platform, x11_platform, wayland_platform, test))]
+    pub(crate) fn retire(&self) {
+        let mut old = self.0.load(Ordering::Acquire);
+        loop {
+            let next = old.checked_add(2).expect("IME lifetime exhausted");
+            match self.0.compare_exchange_weak(old, next, Ordering::AcqRel, Ordering::Acquire) {
+                Ok(_) => return,
+                Err(value) => old = value,
+            }
+        }
+    }
+}
+
+impl ImeStamp {
+    #[cfg(windows_platform)]
+    pub(crate) fn same(&self, other: &Self) -> bool {
+        self.value == other.value && Arc::ptr_eq(&self.lifetime.0, &other.lifetime.0)
+    }
+
+    pub(crate) fn is_current(&self) -> bool {
+        self.lifetime.0.load(Ordering::Acquire) == self.value
+    }
+
+    #[cfg(x11_platform)]
+    pub(crate) fn allowed(&self) -> bool {
+        self.value & 1 != 0
+    }
+}
+
+/// A seat/context can retire independently of the window containing it.
+#[derive(Clone, Debug)]
+#[cfg(any(x11_platform, wayland_platform, test))]
+pub(crate) struct ImeGuard {
+    pub(crate) context: ImeStamp,
+    pub(crate) window: Option<ImeStamp>,
+}
+
+#[cfg(any(x11_platform, wayland_platform, test))]
+impl ImeGuard {
+    pub(crate) fn is_current(&self) -> bool {
+        self.context.is_current() && self.window.as_ref().map_or(true, ImeStamp::is_current)
+    }
+}
+
+/// Wayland's counter includes *every* commit, including cursor-area changes.
+/// A lagging serial inside the current enable is valid; an earlier enable is not.
+#[derive(Debug, Default)]
+#[cfg(any(wayland_platform, test))]
+pub(crate) struct ImeSerial {
+    sent: u32,
+    enabled_at: Option<u32>,
+}
+
+#[cfg(any(wayland_platform, test))]
+impl ImeSerial {
+    pub(crate) fn retire(&mut self) {
+        self.enabled_at = None;
+    }
+
+    pub(crate) fn commit(&mut self, enabled: Option<bool>) {
+        self.sent = self.sent.wrapping_add(1);
+        match enabled {
+            Some(true) => self.enabled_at = Some(self.sent),
+            Some(false) => self.enabled_at = None,
+            None => {},
+        }
+    }
+
+    pub(crate) fn accepts(&self, serial: u32) -> bool {
+        self.enabled_at.is_some_and(|start| {
+            let span = self.sent.wrapping_sub(start);
+            span < (1 << 31) && self.sent.wrapping_sub(serial) <= span
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests;
