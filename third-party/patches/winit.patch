+    let is_applied =
+        || state.lock().unwrap().ime_applied.as_ref().is_some_and(|applied| applied.same(stamp));
+    // A failed reset detached the context to preserve ordinary keyboard input.
+    // Reassociate it behind the gate before retrying, even for a disable.
+    let associated = !retry_reset || native(ImeAction::Associate(true));
+    if !is_applied() {
+        return;
+    }
+    let reset = associated && native(ImeAction::Cancel { active: active || retry_reset });
+    {
+        let mut state = state.lock().unwrap();
+        if !state.ime_applied.as_ref().is_some_and(|applied| applied.same(stamp)) {
+            return;
+        }
+        state.ime_reset_failed = !reset;
+    }
+    if !reset {
+        native(ImeAction::Associate(false));
+        tracing::warn!("IME composition reset failed; native input remains disabled");
+        return;
+    }
+    if !stamp.is_current() {
+        return;
+    }
+    let associated = native(ImeAction::Associate(allowed));
+    let mut state = state.lock().unwrap();
+    if !stamp.is_current() {
+        return;
+    }
+    state.ime_reset_failed = !associated;
+    state.ime_allowed = allowed && associated;
