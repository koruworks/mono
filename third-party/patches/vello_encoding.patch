+    /// Encode a glyph brush with neutral, independently adjustable coverage.
+    /// Non-solid brushes retain their original behavior.
+    pub fn encode_glyph_brush<'b>(&mut self, brush: impl Into<BrushRef<'b>>, alpha: f32) {
+        match brush.into() {
+            BrushRef::Solid(color) => {
+                let color: DrawColor = color.multiply_alpha(alpha).into();
+                self.draw_tags.push(DrawTag::GLYPH_COLOR);
+                self.draw_data.extend([color.rgba, 1.0_f32.to_bits(), 0.0_f32.to_bits()]);
+            }
+            other => self.encode_brush(other, alpha),
+        }
+    }
+
+    /// Set coverage on solid glyphs only, without altering brush opacity,
+    /// shapes, images, clip masks or scene ordering. Call on the final scene.
+    pub fn set_glyph_coverage(&mut self, gamma: f32, cutoff: f32) {
+        let gamma = if gamma.is_finite() { gamma.clamp(0.0, 3.0) } else { 1.0 };
+        let cutoff = if cutoff.is_finite() { cutoff.clamp(0.0, 0.5) } else { 0.0 };
+        for run in &self.resources.glyph_runs {
+            if self.draw_tags.get(run.stream_offsets.draw_tags) == Some(&DrawTag::GLYPH_COLOR) {
+                let offset = run.stream_offsets.draw_data;
+                self.draw_data[offset + 1] = gamma.to_bits();
+                self.draw_data[offset + 2] = cutoff.to_bits();
+            }
+        }
+    }
