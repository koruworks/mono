 fn main() -> Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    let mut font_index = 0;
+    let mut text_color = None;
+    let mut directory =
+        std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../assets/fonts");
+    let mut font_report = false;
+    let mut list_fonts = false;
+    let mut coverage_args = Vec::new();
+    for arg in args {
+        if let Some(name) = arg.strip_prefix("--font=") {
+            font_index = fonts::find(name)?;
+        } else if let Some(value) = arg
+            .strip_prefix("--color=")
+            .or_else(|| arg.strip_prefix("--font-color="))
+        {
+            text_color = Some(quiet::parse_hex_color(value)?);
+        } else if let Some(path) = arg.strip_prefix("--fonts-dir=") {
+            directory = path.into();
+        } else if arg == "--font-report" {
+            font_report = true;
+        } else if arg == "--list-fonts" {
+            list_fonts = true;
+        } else {
+            coverage_args.push(arg);
+        }
+    }
+    let coverage = coverage::Coverage::from_args(&coverage_args)?;
+    if list_fonts {
+        for font in fonts::CHOICES {
+            println!("{}: {}", font.label, font.stack);
+        }
+        return Ok(());
+    }
+    let font_context = fonts::load(&directory)?;
+    if font_report {
+        for font in fonts::CHOICES {
+            for weight in [400.0, 500.0, 600.0, 700.0] {
+                let mut editor = text::Editor::new("Add an image", &font_context);
+                editor.set_font(font.stack);
+                editor.configure(22.0, 30.8, weight);
+                println!(
+                    "{} requested {weight}: {}",
+                    font.label,
+                    editor.font_report()
+                );
+            }
+        }
+        return Ok(());
+    }
+    let mut editor = quiet::Page::new(&font_context);
+    editor.set_font(font_index);
+    if let Some(rgb) = text_color {
+        editor.set_text_color(rgb);
+    }
+    editor.coverage = coverage;
     // Create a winit event loop:
     let event_loop = EventLoop::with_user_event().build()?;

