# Account build settings for this directory's launcher (apps\android\koru.bat,
# not the repository root's). Copy this file to .env.local in this directory
# for `.\koru.bat run-local`, or to .env.production for `.\koru.bat run-prod`,
# fill each value from the configuration of the Koru account API you build
# against, then run that verb. Both copies are gitignored. Other build commands
# take the same settings as Gradle -P properties instead (README.md, "Google
# account build configuration").
# Public Android build settings only. Never put a Google client secret here.
# Blank lines and whole-line comments are allowed; values may be quoted.
# Values are literal: no shell expansion or inline comments.

# The account API's origin. An API on this PC can stay on loopback: run-local
# forwards this port from the selected device to the PC with adb reverse, so
# the API must be listening when the app starts. For an API elsewhere, use
# its HTTPS origin instead.
koruAccountOrigin=http://localhost:8080

# Match KORU_PUBLIC_API_ISSUER in the API configuration exactly.
koruAccountIssuer=http://localhost:8080

# Use KORU_PUBLIC_API_GOOGLE_CLIENT_ID from the API configuration: the WEB
# OAuth client ID, not the Android client ID. A Cloud nightly reads that same
# variable from its GitHub environment. It is not KORU_GOOGLE_DOCS_CLIENT_ID.
# The Android OAuth client for the package and signing certificate is separate
# from this web client id. The build does not create that registration.
koruGoogleServerClientId=REPLACE_ME.apps.googleusercontent.com

# Keep this stable between builds so the saved account namespace stays the same.
koruAccountChannel=internal

# Optional. The public regional credential policy, copied verbatim from the
# API's own KORU_PUBLIC_API_CREDENTIAL_ROLLOUT. It names the region and the
# issuer a Cloud sync credential is verified against, and it carries no key.
# Without it the phone works exactly as before with **no Cloud sync attached**:
# the account, peer sync and local documents are unaffected, and nothing
# arrives from Koru Cloud.
#
# Verbatim is not a style note. legacy_cutover_millis is the operator-recorded
# boundary the API records once; the device admits a legacy credential only
# while issued_at <= cutover. Copy the API's own value — a placeholder left in,
# or a cutover invented here, refuses every credential the API mints, and the
# device reports it far away as enrollment `attestation_invalid`. A legacy
# issuance with a zero cutover is now refused at startup rather than silently.
# koruAccountCredentialRollout={"region":"US","regional_issuer":"http://127.0.0.1:8080","legacy_issuer":"http://localhost:8080","legacy_cutover_millis":REPLACE_WITH_THE_API_CUTOVER,"issuance":"legacy","legacy_access_kids":["access-local-1"],"legacy_attestation_kids":["attestation-local-1"]}


# Optional. A local object worker this build may send blob bytes to, beside
# the compiled-in per-region set. Set it to the SAME origin as the stack's
# KORU_OBJECT_WORKER_ADVERTISE, scheme and port included — the allowlist
# compares origins, not hosts.
#
# Without it a phone allocates an upload, is handed that worker's byte URL and
# refuses it, which reads as a broken transfer engine rather than a missing
# setting. The desktop reads KORU_CLOUD_BLOB_BYTE_ORIGINS for this; nothing
# sets an environment variable in an Android process, so the phone is told at
# build time instead.
#
# It must be this machine's LAN address, not loopback: a phone given
# 127.0.0.1 dials itself. Only a loopback, private-range or link-local address
# is admitted — a public host is refused on the device and the production set
# stands — and the object worker's port has to be open on the host firewall.
# koruBlobByteOrigins=http://192.168.1.118:8081
