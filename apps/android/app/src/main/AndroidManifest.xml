<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".KoruApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${koruAppLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Koru">
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="koru.do"
                    android:pathPrefix="/link-device" />
            </intent-filter>
        </activity>
        <!--
          The verified App Link a browser sign-in (Sign in with Apple) returns
          through. A no-display trampoline hands the URL to the application-owned
          account service and brings the existing MainActivity forward, so
          MainActivity's launch mode and the link-device filter above stay as
          they were. www.koru.do serves the assetlinks.json that verifies it.
        -->
        <activity
            android:name=".BrowserSignInReturnActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.koru.do"
                    android:path="/v1/oauth/app/callback" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_to_koru"
            android:launchMode="singleTop">
            <intent-filter android:label="@string/share_to_koru">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          Handing an exported file to another app.

          Koru's own storage is private, so a player cannot open a path; it
          opens a `content://` URI this provider vends under a short-lived
          read grant. `exported="false"` with `grantUriPermissions="true"` is
          the pair that means "nobody may browse this, and the one app I just
          handed a URI to may read that one file".
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/koru_file_paths" />
        </provider>
    </application>
</manifest>
